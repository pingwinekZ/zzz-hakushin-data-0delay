      "SelectableBuff": {
        "69010201": {
          "Title": "Graceful Mastery",
          "Desc": "· Increases Agent Anomaly Buildup Rate by <color=#2BAD00>25%</color> and Anomaly Proficiency by <color=#2BAD00>40</color>.\n· When an enemy suffers an Attribute Anomaly, Agents recover <color=#2BAD00>500</color> additional Decibels and ATK increases by <color=#2BAD00>30%</color> for 15s. The Decibel recovery effect can trigger once every 15s."
        },
        "69012701": {
          "Title": "Break Through",
          "Desc": "· Agent Sheer DMG <color=#2BAD00>increases by 15%</color>. When Agents with [Rupture] specialty hit enemies with attacks, ignore <color=#2BAD00>20%</color> of the target's All-DMG RES.\n· After activating an EX Special Attack, Agent <color=#FF5521>Fire DMG</color> increases by 40% for 15s. Repeated triggers reset the duration."
        },
        "69012702": {
          "Title": "Tempering Body",
          "Desc": "· Agents deal <color=#2BAD00>20% more</color> DMG and attacks ignore <color=#2BAD00>10%</color> of enemy All-DMG RES.\n· Attack specialty Agents' ATK <color=#2BAD00>increases by 20%</color>, Basic Attack DMG <color=#2BAD00>increases by 40%</color>, and ignore <color=#2BAD00>20%</color> of enemy DEF."
        }
      }
    },
    "6902602": {
      "Name": "Ye Shiyuan the Thrall",
      "StageNum": 2,
      "MonsterLevel": 70,
      "LayerBuff": {
        "69012102": { "Title": "", "Desc": "" },
        "69012602": {
          "Title": "",
          "Desc": "· When Sobek and The Thrall alternate turns, The Thrall gains 1 stack of <color=#FFFFFF>Contract</color> and <color=#FFFFFF>Self-Sacrifice</color>. Contract and Self-Sacrifice can stack up to 3 times. Each stack of Contract increases All-Attribute Anomaly Buildup RES by <color=#FFAF2C>15%</color>, each stack of Self-Sacrifice reduces The Thrall's DEF by <color=#FFAF2C>8%</color>. When The Thrall is Stunned, CRIT DMG taken increases by <color=#FFAF2C>50%</color>."
        },
        "69012603": {
          "Title": "",
          "Desc": "· When Agents inflict <color=#FFAF2C>Weakened</color> on Sobek and The Thrall, <color=#FFAF2C>1,500 Performance Points</color> will be awarded. When an Agent <color=#FFAF2C>eliminates Sobek</color>, <color=#FFAF2C>2,000 Performance Points</color> will be awarded. Up to a maximum of 5,000 Performance Points can be earned."
        },
        "69013004": {
          "Title": "",
          "Desc": "· Suitable for Agents with <IconMap:Icon_AvatarClass_Stun><color=#FFAF2C>Stun</color> specialty."
        }
