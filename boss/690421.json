        "69012801": {
          "Title": "Mutation",
          "Desc": "· Agent ATK <color=#2BAD00>increases by 25%</color>, Anomaly Proficiency <color=#2BAD00>increases by 40</color>.\n· After inflicting Attribute Anomaly on enemies, their All-DMG RES is <color=#2BAD00>reduced by 10%</color>, and Agent Attribute Anomaly DMG against them is <color=#2BAD00>increased by 30%</color> for 15s. Repeated triggers reset the duration."
        },
        "69012904": {
          "Title": "Ride the Current",
          "Desc": "· Agents within Ether Veil have their ATK <color=#2BAD00>increased by 15%</color>, and when their <color=#FFFFFF>Basic Attack</color> or <color=#FFFFFF>Ultimate</color> hits an enemy, it ignores <color=#2BAD00>15%</color> of enemy DEF.\n· After an Agent with Assist specialty activates an <color=#FFFFFF>EX Special Attack</color>, the whole squad's <color=#F0D12B>Physical DMG</color> <color=#2BAD00>increases by 20%</color> and their CRIT DMG <color=#2BAD00>increases by 40%</color> for 20s. Repeated triggers reset the duration."
        },
        "69012905": {
          "Title": "Overwhelming Might",
          "Desc": "· Agent Max HP <color=#2BAD00>increases by 30%</color>, Ultimate DMG <color=#2BAD00>increases by 40%</color>.\n· After using an Ultimate, Energy and Adrenaline Generation Rate <color=#2BAD00>increase by 15%</color>, <color=#FE437E>Ether DMG</color> and <color=#FF5521>Fire DMG</color> <color=#2BAD00>increase by 40%</color> for 20s. Repeated triggers reset the duration."
        }
      }
