    "6901701": {
      "Name": "Miasmic Fiend - Unfathomable",
      "StageNum": 1,
      "MonsterLevel": 70,
      "LayerBuff": {
        "69011502": { "Title": "", "Desc": "" },
        "69011602": {
          "Title": "",
          "Desc": "· When Miasmic Fiend is affected by <color=#FFAF2C>Attribute Anomaly</color>, it takes 8% bonus Anomaly DMG from Agents, stacking up to 6 times; activating <Term:2000002> clears all stacks, with each stack increasing the reduction efficiency of <Term:2000002> by 2.5%."
        },
        "69011603": {
          "Title": "",
          "Desc": "· When Agents bait Miasmic Fiend's ground attack into <color=#FFAF2C>detonating at least 5 Miasma Pools at once</color> and <color=#FFAF2C>avoid being hit by the attack and pool explosions</color>, they will earn <color=#FFAF2C>1,700 Performance Points</color>, up to a maximum of 5,000."
        }
      },
