      "ARankGoal": 14000,
      "BRankGoal": 6000,
      "SelectableBuff": {
        "69010401": {
          "Title": "Dazing Force",
          "Desc": "· The Agent's Daze value dealt <color=#2BAD00>increases by 15%</color>, and the DMG dealt by <color=#FFFFFF>Chain Attack</color> <color=#2BAD00>increases by 60%</color>.\n· Each use of <color=#FFFFFF>Chain Attack</color> increases the all squad members' ATK by <color=#2BAD00>10%</color> for 20 seconds, stacking up to 4 times. The duration of each stack is calculated separately."
        },
        "69010501": {
          "Title": "Blazing Chill",
          "Desc": "· The Agent's <color=#FF5521>Fire Anomaly Buildup Rate</color> and <color=#98EFF0>Ice Anomaly Buildup Rate</color> <color=#2BAD00>increase by 20%</color>, and ATK <color=#2BAD00>increases by 25%</color>.\n· When inflicting <color=#FFFFFF>Attribute Anomaly</color> on enemies, the Agent <color=#2BAD00>restores 300 Decibels</color> and <color=#2BAD00>increases Anomaly Proficiency by 80 points</color>, lasting 15s."
        },
        "69010502": {
          "Title": "Final Assault",
          "Desc": "· The Agent's Decibel Generation Rate <color=#2BAD00>increases by 20%</color>.\n· <color=#FFFFFF>Ultimate</color> DMG <color=#2BAD00>increases by 30%</color>. When the <color=#FFFFFF>Ultimate</color> hits an enemy, it reduces the enemy's DEF by <color=#2BAD00>15%</color> for 20s."
        }
      }
    },
    "6900502": {
      "Name": "Sacrifice - Bringer",
      "StageNum": 2,
      "MonsterLevel": 70,
      "LayerBuff": {
        "69010107": {
          "Title": "",
          "Desc": "· Successfully <color=#FFAF2C>interrupting a chant</color> grants <color=#FFAF2C>2,000 Performance Points</color>. A maximum of 5,000 Performance Points can be obtained."
        },
        "69010505": {
          "Title": "",
          "Desc": "· When inflicting <color=#FFAF2C>an Attribute Anomaly or Disorder</color> on a boss enemy, all squad members gain 1 stack of <color=#FFFFFF>Laser Focus</color>, stacking up to 6 times. Each stack of <color=#FFFFFF>Laser Focus</color> increases the Agent's ATK by <color=#FFAF2C>8%</color>. With at least 3 stacks of <color=#FFFFFF>Laser Focus</color>, inflicting an <color=#FFAF2C>Attribute Anomaly</color> will increase its duration by 5s. When Sacrifice - Bringer attacks with his Sacrificial Knife, all squad members' <color=#FFFFFF>Laser Focus</color> stacks will be reset."
        },
        "69010506": { "Title": "", "Desc": "" }
