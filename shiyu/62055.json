        "62001552": {
          "Title": "Treacherous Domain",
          "Desc": "· Agent <color=#FE437E>Ether DMG</color> increases by 20%.\n· When Agents inflict an <color=#FFFFFF>Attribute Anomaly</color> on enemies, their DEF is reduced by 15%, and All-Attribute RES is reduced by 15% for 10s. Repeated triggers reset the duration."
        },
        "62001553": {
          "Title": "Biting Cold",
          "Desc": "· When an Agent with <color=#FFFFFF>Attack</color> specialty lands <color=#FFFFFF>Basic Attack</color>, it ignores 30% of enemy <color=#98EFF0>Ice RES</color>. \n· After an Agent with <color=#FFFFFF>Attack</color> specialty uses a <color=#FFFFFF>Chain Attack</color> or <color=#FFFFFF>EX Special Attack</color>, their <color=#98EFF0>Ice DMG</color> increases by 20% and CRIT DMG increases by 40% for 15s. Repeated triggers reset the duration."
        }
      },
